-- ==== (b) Function: fn_sale_value ====
CREATE OR REPLACE FUNCTION fn_sale_value(p_medicine_id INTEGER, p_quantity INTEGER)
RETURNS NUMERIC AS $$
DECLARE
    v_price NUMERIC(10,2);
BEGIN
    IF p_quantity IS NULL OR p_quantity <= 0 THEN
        RAISE EXCEPTION 'Invalid quantity: %', p_quantity;
    END IF;

    SELECT unit_price INTO v_price
    FROM medicines
    WHERE medicine_id = p_medicine_id;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown medicine: %', p_medicine_id;
    END IF;

    RETURN v_price * p_quantity;
END;
$$ LANGUAGE plpgsql;

SELECT fn_sale_value(1, 4);          -- 10.00
-- SELECT fn_sale_value(99, 1);      -- error: unknown medicine
-- SELECT fn_sale_value(1, 0);       -- error: invalid quantity

-- ==== (c) Procedure: pr_record_sale ====
CREATE OR REPLACE PROCEDURE pr_record_sale(
    p_medicine_id INTEGER, p_quantity INTEGER, p_sold_on DATE)
LANGUAGE plpgsql AS $$
DECLARE
    v_price NUMERIC(10,2);
    v_stock INTEGER;
BEGIN
    IF p_quantity IS NULL OR p_quantity <= 0 THEN
        RAISE EXCEPTION 'Invalid quantity: %', p_quantity;
    END IF;
    IF p_sold_on IS NULL THEN
        RAISE EXCEPTION 'Sale date must not be NULL';
    END IF;

    -- FOR UPDATE locks the row so two sales cannot oversell the same stock
    SELECT unit_price, stock_qty INTO v_price, v_stock
    FROM medicines
    WHERE medicine_id = p_medicine_id
    FOR UPDATE;

    IF NOT FOUND THEN
        RAISE EXCEPTION 'Unknown medicine: %', p_medicine_id;
    END IF;
    IF v_stock < p_quantity THEN
        RAISE EXCEPTION 'Insufficient stock: % available, % requested',
                        v_stock, p_quantity;
    END IF;

    INSERT INTO sales (medicine_id, quantity, unit_price, sold_on)
    VALUES (p_medicine_id, p_quantity, v_price, p_sold_on);   -- current price stored

    UPDATE medicines
    SET stock_qty = stock_qty - p_quantity                    -- deducted exactly once
    WHERE medicine_id = p_medicine_id;
END;
$$;

-- An exception aborts the whole CALL, so an invalid sale changes nothing:
-- CALL pr_record_sale(1, 9999, CURRENT_DATE);   -- insufficient stock
-- CALL pr_record_sale(99, 1, CURRENT_DATE);     -- unknown medicine

-- ==== (d) Trigger: stock audit ====
CREATE OR REPLACE FUNCTION trg_fn_stock_audit() RETURNS TRIGGER AS $$
BEGIN
    INSERT INTO stock_audit (medicine_id, old_qty, new_qty)
    VALUES (NEW.medicine_id, OLD.stock_qty, NEW.stock_qty);
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_stock_audit
AFTER UPDATE ON medicines
FOR EACH ROW
WHEN (OLD.stock_qty IS DISTINCT FROM NEW.stock_qty)   -- only when stock really changes
EXECUTE FUNCTION trg_fn_stock_audit();

