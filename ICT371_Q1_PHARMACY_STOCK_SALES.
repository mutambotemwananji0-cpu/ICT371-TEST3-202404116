-- A price change does not touch stock_qty, so it creates no audit row:
UPDATE medicines SET unit_price = 2.60 WHERE medicine_id = 1;
UPDATE medicines SET unit_price = 2.50 WHERE medicine_id = 1;
SELECT COUNT(*) FROM stock_audit;                -- unchanged

-- ==== (e) View: v_low_stock ====
CREATE OR REPLACE VIEW v_low_stock AS
SELECT medicine_id,
       medicine_name,
       unit_price,
       stock_qty AS remaining_stock
FROM medicines
WHERE stock_qty < 10;

-- Query after a sale
CALL pr_record_sale(4, 1, CURRENT_DATE);         -- ORS drops from 8 to 7
SELECT * FROM v_low_stock ORDER BY remaining_stock;

-- ==== (f) Index ====
-- Justification: the search filters on one medicine (equality) and a range of
-- sold_on. Equality column first, range column second, lets PostgreSQL jump to
-- that medicine's entries and read the date range in order, instead of
-- scanning the whole sales table.
CREATE INDEX idx_sales_medicine_date ON sales (medicine_id, sold_on);
ANALYZE sales;

SET enable_seqscan = off;   -- demo only: tiny tables would otherwise use a seq scan
EXPLAIN
SELECT sale_id, quantity, unit_price, sold_on
FROM sales
WHERE medicine_id = 1
  AND sold_on BETWEEN '2026-11-20' AND '2026-11-23';
RESET enable_seqscan;

-- ==== (g) Scheduled job: pr_refresh_sales ====
CREATE OR REPLACE PROCEDURE pr_refresh_sales(p_day DATE)
LANGUAGE plpgsql AS $$
DECLARE
    v_qty    INTEGER;
    v_amount NUMERIC(12,2);
BEGIN
    IF p_day IS NULL THEN
        RAISE EXCEPTION 'Day must not be NULL';
    END IF;

    SELECT COALESCE(SUM(quantity), 0),
           COALESCE(SUM(quantity * unit_price), 0)
    INTO v_qty, v_amount
    FROM sales
    WHERE sold_on = p_day;

    -- Replace, never add: the day's row is overwritten on every run
    INSERT INTO daily_sales (sales_date, total_qty, total_amount)
    VALUES (p_day, v_qty, v_amount)
    ON CONFLICT (sales_date) DO UPDATE
    SET total_qty    = EXCLUDED.total_qty,
        total_amount = EXCLUDED.total_amount;
END;
$$;

CALL pr_refresh_sales('2026-11-20');
CALL pr_refresh_sales('2026-11-20');             -- rerun: no duplicate, no double count
SELECT * FROM daily_sales;

