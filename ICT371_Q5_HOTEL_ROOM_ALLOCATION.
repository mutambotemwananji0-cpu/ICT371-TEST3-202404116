-- ==== (e) View: v_room_occupancy ====
CREATE OR REPLACE VIEW v_room_occupancy AS
SELECT r.room_id,
       r.room_number,
       r.capacity,
       COUNT(a.allocation_id)              AS occupied_beds,
       r.capacity - COUNT(a.allocation_id) AS free_beds
FROM rooms r
LEFT JOIN allocations a
       ON a.room_id = r.room_id
      AND a.status = 'ACTIVE'              -- filter in ON so empty rooms still appear
GROUP BY r.room_id, r.room_number, r.capacity;

SELECT * FROM v_room_occupancy ORDER BY room_number;

-- ==== (f) Index ====
-- Justification: occupancy checks count ACTIVE allocations for one room. A
-- partial index on room_id covering only ACTIVE rows is small (ENDED history is
-- left out) and exactly matches the query used by the function, view and trigger.
CREATE INDEX idx_alloc_active_room
ON allocations (room_id)
WHERE status = 'ACTIVE';
